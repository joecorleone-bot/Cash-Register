# Neon PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Role-based POS access. Configure real values in Vercel Environment Variables.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-admin-password"
CASHIER_USERNAME="cashier"
CASHIER_PASSWORD="change-cashier-password"

# Recommended: long random secret used to sign login sessions.
AUTH_SECRET="replace-with-a-long-random-secret"

# Legacy fallback only. ADMIN_PASSWORD replaces this when configured.
SITE_PASSWORD=""
